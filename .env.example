# BloodBridge Environment Configuration Template
# Copy to .env for local production configuration

# ==========================================
# Database Configuration (PostgreSQL 16+)
# ==========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bloodbridge
SPRING_DATASOURCE_USERNAME=bloodbridge
SPRING_DATASOURCE_PASSWORD=change_me_to_a_strong_password_2026

# ==========================================
# Security & JWT Authentication
# ==========================================
# Base64-encoded 256-bit HMAC secret
JWT_SECRET=c2VjdXJlX2Jsb29kYnJpZGdlX2p3dF9zZWNyZXRfa2V5XzIwMjZfc3VwZXJfc2VjdXJlXzI1Nl9iaXRzX2xvbmc=
# Access Token Lifetime: 15 minutes (900,000 ms)
JWT_EXPIRATION_MS=900000
# Refresh Token Lifetime: 7 days (604,800,000 ms)
JWT_REFRESH_EXPIRATION_MS=604800000

# ==========================================
# CORS Allowed Origins
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ==========================================
# SMS Provider Configuration
# Supported options: logging (dev default), msg91, twilio
# ==========================================
SMS_PROVIDER=logging
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==========================================
# Email Notification Configuration (SMTP)
# ==========================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ==========================================
# Hospital Document Upload Storage
# ==========================================
UPLOAD_DIR=/app/uploads
